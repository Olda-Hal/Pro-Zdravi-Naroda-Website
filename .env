# Domain/app
APP_DOMAIN=localhost

# Public ports on host machine
FRONTEND_PORT=8092
BACKEND_PORT=8093
DB_PORT=8094

# Database
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql://app:app@db:5432/appdb

# Frontend -> backend
VITE_API_URL=http://localhost:8093

# Backend CORS (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:8092
